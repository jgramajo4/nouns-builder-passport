# WalletConnect / Reown project ID — REQUIRED for the QR sign-in popup.
# Without it, the WalletConnect connector is disabled and no QR code appears.
# Get a free project ID at https://cloud.reown.com (formerly cloud.walletconnect.com).
VITE_WC_PROJECT_ID=

# Optional: custom Ethereum mainnet RPC URL (defaults to a public endpoint).
VITE_RPC_URL=
